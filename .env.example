# Local development (Next 3000 + API 4600)
# Copy to .env for local use. Never commit real secrets.
HOST_PORT=3000
API_PORT=4600
API_HOST=127.0.0.1
DB_PATH=./data/bal-topluluk.db
# Required in production and at least 16 characters long.
ADMIN_TOKEN=bal-topluluk-yerel-admin-anahtari
# Set to 1 only when a trusted reverse proxy forwards the real client IP.
TRUST_PROXY=0
